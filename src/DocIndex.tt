<#@ template debug="true" hostspecific="false" visibility="internal" language="C#" inherits="TemplateBase" #>
<#@ parameter name="Namespace" type="string" #>
<#@ parameter name="DeviceMetadata" type="DeviceMetadata" #>
<#@ import namespace="Harp.Generators" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".md" #>
<#
var publicRegisters = DeviceMetadata.Registers.Where(register => register.Value.Visibility == RegisterVisibility.Public).ToList();
#>
| name | address | type | length | access | description | range | interfaceType |
|-|-|-|-|-|-|-|-|
<#
foreach (var entry in publicRegisters)
{
    var name = entry.Key;
    var register = entry.Value;
    var length = register.Length > 0 ? register.Length.ToString() : "";
    var range = TemplateHelper.GetDocumentationRange(register.MinValue, register.MaxValue, register.DefaultValue);
    var interfaceType = TemplateHelper.GetDocumentationInterfaceType(DeviceMetadata, Namespace, name, register);
#>
| [<#= name #>](xref:<#= Namespace #>.<#= name #>) | <#= register.Address #> | <#= register.Type #> | <#= length #> | <#= register.Access #> | <#= register.Description #> | <#= range #> | <#= interfaceType #> |
<#
}
#>
