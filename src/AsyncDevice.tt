<#+
void WriteSummary(string indent, string text)
{
    WriteLine($"{indent}/// <summary>");
    foreach (var line in TemplateHelper.GetDocumentationLines(text, maxLineLength: 85))
    {
        WriteLine($"{indent}/// {line}");
    }
    WriteLine($"{indent}/// </summary>");
}
