<#@ template debug="true" hostspecific="false" visibility="internal" language="C#" inherits="TemplateBase" #>
<#@ parameter name="Namespace" type="string" #>
<#@ parameter name="DeviceMetadata" type="DeviceMetadata" #>
<#@ parameter name="RegisterName" type="string" #>
<#@ import namespace="Harp.Generators" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".md" #>
<#
var register = DeviceMetadata.Registers[RegisterName];
var defaultValue = TemplateHelper.GetDocumentationValue(register.DefaultValue);
var range = TemplateHelper.GetDocumentationRange(register.MinValue, register.MaxValue);
var interfaceType = TemplateHelper.GetDocumentationInterfaceType(DeviceMetadata, Namespace, RegisterName, register);
#>
---
uid: <#= Namespace #>.<#= RegisterName #>
generatedContent: *content
---

- Address: <#= register.Address #>
- Payload type: <#= register.Type #>
<#
if (register.Length > 0)
{
#>
- Length: <#= register.Length #>
<#
}
#>
- Access: <#= register.Access #>
<#
if (defaultValue.Length > 0)
{
#>
- Default value: <#= defaultValue #>
<#
}
#>
<#
if (range.Length > 0)
{
#>
- Range: <#= range #>
<#
}
#>
<#
if (interfaceType.Length > 0)
{
#>
- Interface type: <#= interfaceType #>
<#
}
#>
<#
if (register.PayloadSpec != null && register.PayloadSpec.Count > 0)
{
    var columns = new[] { "name", "offset", "length", "mask", "default", "range", "interfaceType", "description" };
    var rows = new List<string[]>();
    foreach (var entry in register.PayloadSpec)
    {
        var member = entry.Value;
        rows.Add(new[]
        {
            entry.Key,
            member.Offset.HasValue ? member.Offset.GetValueOrDefault().ToString() : "",
            member.Length > 0 ? member.Length.ToString() : "",
            member.Mask.HasValue ? $"0x{member.Mask.GetValueOrDefault():X}" : "",
            TemplateHelper.GetDocumentationValue(member.DefaultValue),
            TemplateHelper.GetDocumentationRange(member.MinValue, member.MaxValue),
            TemplateHelper.GetDocumentationInterfaceType(DeviceMetadata, Namespace, member),
            member.Description
        });
    }
#>

### Payload members

<#
    foreach (var line in TemplateHelper.GetDocumentationTable(columns, rows))
    {
#>
<#= line #>
<#
    }
}
#>
